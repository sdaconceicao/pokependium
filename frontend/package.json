{
  "name": "pokependium-frontend",
  "version": "0.7.1",
  "private": true,
  "scripts": {
    "prebuild": "pn codegen",
    "build": "next build",
    "start": "next start",
    "start:dev": "concurrently \"next dev --turbopack --port 3010\" \"pn  codegen:watch\"",
    "start:dev:test": "NODE_ENV=test next dev --port 3010",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "codegen": "graphql-codegen",
    "codegen:watch": "graphql-codegen --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@apollo/client": "^4.2.12",
    "@code-x/lago": "^0.9.1",
    "@pokemonle/icons-react": "^0.0.3",
    "@tanstack/react-query": "^5.102.8",
    "@untitled-ui/icons-react": "^0.1.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/related-projects": "^1.1.1",
    "clsx": "^2.1.1",
    "graphql": "^17.0.2",
    "nanoid": "^6.0.1",
    "next": "^16.3.3",
    "picocolors": "^1.1.1",
    "react": "^19.2.8",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.2.8",
    "source-map-js": "^1.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@graphql-codegen/cli": "^7.3.1",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.6",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/expect": "^4.1.11",
    "concurrently": "^10.0.5",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
