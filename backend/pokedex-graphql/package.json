{
  "name": "pokedex-graphql",
  "private": true,
  "description": "The API for the Pokependium project",
  "version": "0.6.0",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=18.0"
  },
  "scripts": {
    "compile": "node scripts/embed-schema.mjs && tsc -p tsconfig.build.json",
    "start": "pn compile && nodemon ./dist/index.js",
    "start:dev": "node scripts/embed-schema.mjs && concurrently \"tsx watch ./src/index.ts\" \"pn  generate\"",
    "start:dev:mock": "node scripts/embed-schema.mjs && USE_MOCK_API=true tsx watch ./src/index.ts",
    "generate": "graphql-codegen --watch \"src/schema.graphql\"",
    "generate:schema": "node scripts/embed-schema.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "tsc": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@apollo/datasource-rest": "^6.4.1",
    "@apollo/utils.keyvaluecache": "^4.0.0",
    "@parcel/watcher": "^2.6.0",
    "graphql": "^17.0.2",
    "graphql-yoga": "^5.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@graphql-codegen/cli": "^7.3.1",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-resolvers": "^6.1.0",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^10.0.5",
    "msw": "^2.15.0",
    "nodemon": "^3.0.0",
    "ts-node": "^10.9.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
