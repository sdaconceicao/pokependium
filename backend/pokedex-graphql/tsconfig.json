{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node"]
  },
  "files": ["src/graphql.d.ts"],
  "include": ["src/**/*.ts"],
  "exclude": [
    "dist",
    "node_modules",
    "codegen.ts",
    "**/*.test.ts",
    "**/vitest.setup.ts",
    "src/vitest-env.d.ts",
    "src/test/**"
  ]
}
