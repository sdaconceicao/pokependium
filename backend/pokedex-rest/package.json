    "typeorm": "^1.1.0",
    "typeorm-extension": "^3.7.1",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@jorgebodega/typeorm-seeding": "^7.1.0",
